# ZarinCoach — Git attributes
# Normalise line endings (LF) for all text files.
* text=auto eol=lf

# Binary assets
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.pdf    binary
*.woff   binary
*.woff2  binary
*.zip    binary

# Generated / vendored files: collapse in diffs and exclude from language stats.
assets/css/*.css           linguist-generated=true -diff
assets/js/*.min.js         linguist-generated=true -diff
languages/*.pot            linguist-generated=true
package-lock.json          linguist-generated=true -diff
inc/redux/**               linguist-vendored=true

# Files that are not part of the installable theme (git archive / GitHub source zips).
.github/          export-ignore
docs/             export-ignore
.gitattributes    export-ignore
.gitignore        export-ignore
.editorconfig     export-ignore
